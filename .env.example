# Ports
HTTP_PORT=3000
HTTPS_PORT=3001

# User/Group
PUID=1000
PGID=100

# Selkies Web UI
# CUSTOM_USER=
# PASSWORD=

# Shared Memory
SHM_SIZE=1gb

# Nightly WeChat Restart Schedule
# ENABLE_WECHAT_NIGHTLY_RESTART=true
# WECHAT_NIGHTLY_STOP_TIME=23:30
# WECHAT_NIGHTLY_START_TIME=01:30

# WeChat Auto-Login on Startup/Restart
# ENABLE_WECHAT_AUTO_LOGIN=true
# AUTO_LOGIN_DELAY=3

# WeChat Auto Re-Login after a forced logout (needs the window watchdog)
# ENABLE_WECHAT_AUTO_RELOGIN=true
# WECHAT_RELOGIN_MAX_ATTEMPTS=3
# WECHAT_RELOGIN_RETRY_DELAY=30

# Webcam Forwarding (experimental, Linux host only, needs v4l2loopback on host)
# WECHAT_WEBCAM_DEVICE=/dev/video10
# WECHAT_WEBCAM_WIDTH=640
# WECHAT_WEBCAM_HEIGHT=480
# WECHAT_WEBCAM_BRIDGE_PORT=8767

# Second-Display Window Manager (experimental): tile WeChat's non-main windows
# (mini programs, image/video viewers) onto a second selkies browser window
# when one is opened, and recall them when it closes. See docs/second-display.md
# ENABLE_WECHAT_SECOND_DISPLAY=true



